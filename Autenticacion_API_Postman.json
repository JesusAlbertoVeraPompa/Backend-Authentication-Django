                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/verify/email/{{email_verify_token}}/",
            "description": "Reemplaza {{email_verify_token}} con el UUID que llegó al correo, o setea la variable en la colección."
          }
        }
      ]
    },
    {
