              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('campos obligatorios', () => {",
                  "  ['id','email','first_name','last_name','role','is_verified'].forEach(f => {",
                  "    pm.expect(d).to.have.property(f);",
                  "  });",
                  "});"
