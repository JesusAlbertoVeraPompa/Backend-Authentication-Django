{
  "info": {
    "name": "Autenticacion API v1",
    "description": "Colección completa para probar todos los endpoints antes de producción.\n\n**Flujo recomendado:**\n1. Ejecuta 'Register' → copia el email\n2. Ejecuta 'Login' → los tokens se guardan automáticamente\n3. Usa cualquier endpoint protegido sin copiar nada manualmente\n\nLas variables {{access_token}}, {{refresh_token}} y {{user_id}} se llenan solas con los scripts de los requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "reset_token", "value": "", "type": "string" },
    { "key": "email_verify_token", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 AUTH — Registro y Login",
      "item": [
        {
          "name": "01 · Register (crear cuenta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success true', () => pm.expect(r.success).to.be.true);",
                  "pm.test('data.email existe', () => pm.expect(r.data.email).to.exist);",
                  "if (r.data && r.data.id) { pm.collectionVariables.set('user_id', r.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Pérez\",\n  \"birth_date\": \"1995-06-15\",\n  \"phone_number\": \"+573001234567\",\n  \"password\": \"SecurePass123!\",\n  \"password_confirm\": \"SecurePass123!\"\n}"
            }
          }
        },
        {
          "name": "01b · Register — email duplicado (debe dar 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('success false', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Pérez\",\n  \"password\": \"SecurePass123!\",\n  \"password_confirm\": \"SecurePass123!\"\n}"
            }
          }
        },
        {
          "name": "01c · Register — contraseñas no coinciden (debe dar 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const r = pm.response.json();",
                  "pm.test('error en password_confirm', () => pm.expect(r.errors).to.have.property('password_confirm'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"otro@example.com\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"García\",\n  \"password\": \"SecurePass123!\",\n  \"password_confirm\": \"OtraPass456!\"\n}"
            }
          }
        },
        {
          "name": "02 · Login ✅ (guarda tokens automáticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('access token existe', () => pm.expect(r.data.access).to.exist);",
                  "pm.test('refresh token existe', () => pm.expect(r.data.refresh).to.exist);",
                  "pm.test('user info completa', () => {",
                  "  const u = r.data.user;",
                  "  pm.expect(u.id).to.exist;",
                  "  pm.expect(u.email).to.exist;",
                  "  pm.expect(u.role).to.exist;",
                  "});",
                  "pm.collectionVariables.set('access_token', r.data.access);",
                  "pm.collectionVariables.set('refresh_token', r.data.refresh);",
                  "pm.collectionVariables.set('user_id', r.data.user.id);",
                  "console.log('✅ Tokens guardados. user_id:', r.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            }
          }
        },
        {
          "name": "02b · Login — credenciales incorrectas (debe dar 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('success false', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"ContraseñaWrong!\"\n}"
            }
          }
        },
        {
          "name": "03 · Refresh token (obtener nuevo access)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('nuevo access token', () => pm.expect(r.access).to.exist);",
                  "if (r.access) { pm.collectionVariables.set('access_token', r.access); }",
                  "console.log('✅ Access token renovado');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/token/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "04 · Logout (invalida refresh token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "console.log('⚠️  Refresh token invalidado. Haz Login de nuevo para continuar.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/logout/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
    {
