    {
      "name": "👥 USUARIOS — Gestión admin",
      "item": [
        {
          "name": "13 · Listar usuarios (requiere Admin o Personal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('paginación correcta', () => {",
                  "  pm.expect(d).to.have.property('count');",
                  "  pm.expect(d).to.have.property('results');",
                  "  pm.expect(d.results).to.be.an('array');",
