              "mode": "raw",
              "raw": "{\n  \"code\": \"000000\"\n}"
            }
          }
        },
        {
          "name": "07 · Verificar Email (con token del correo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
